{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flutter: run web",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "-d",
        "chrome",
        "--web-port=3000",
        "--dart-define=API_BASE_URL=http://localhost:8000"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*flutter run.*",
          "endsPattern": "^.*Application running.*"
        }
      }
    }
  ]
}
