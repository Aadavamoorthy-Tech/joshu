### **2.3 SignInScreen Implementation Details**

```dart
// File: app/lib/presentation/screens/sign_in_screen.dart

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_web_auth_2/flutter_web_auth_2.dart';

class SignInScreen extends ConsumerStatefulWidget {
  const SignInScreen({Key? key}) : super(key: key);

  @override
  ConsumerState<SignInScreen> createState() => _SignInScreenState();
}

class _SignInScreenState extends ConsumerState<SignInScreen> {
  bool _isLoading = false;
  String? _errorMessage;

  @override
  void initState() {
    super.initState();
    // Check if already signed in (session restored)
    _checkExistingSession();
  }

  Future<void> _checkExistingSession() async {
    final authState = ref.read(authControllerProvider);
    // If authenticated, navigate to home immediately
    if (authState.maybeWhen(
      data: (state) => state.isAuthenticated,
      orElse: () => false,
    )) {
      _navigateToHome();
    }
  }

  Future<void> _handleSignIn() async {
    setState(() {
      _isLoading = true;
      _errorMessage = null;
    });

    try {
      // Step 1: Get OAuth consent URL from backend
      final apiClient = ref.read(apiClientProvider);
      final signinResponse = await apiClient.get('/auth/signin');
      
      if (signinResponse == null) {
        throw Exception('Failed to get signin URL');
      }

      final redirectUrl = signinResponse['redirect_url'] as String;
      if (redirectUrl.isEmpty) {
        throw Exception('Empty redirect URL from backend');
      }

      // Step 2: Launch OAuth flow in webview/browser
      // flutter_web_auth_2 handles the redirect interception
      final result = await FlutterWebAuth2.authenticate(
        url: redirectUrl,
        callbackUrlScheme: 'joshu',  // Custom scheme for redirect
      );

      // Step 3: Extract authorization code from redirect
      final uri = Uri.parse(result);
      final code = uri.queryParameters['code'];
      final state = uri.queryParameters['state'];

      if (code == null || code.isEmpty) {
        throw Exception('No authorization code received');
      }

      // Step 4: Send authorization code to backend for token exchange
      final callbackResponse = await apiClient.get(
        '/auth/callback',
        queryParameters: {
          'code': code,
          'state': state ?? '',
        },
      );

      if (callbackResponse == null) {
        throw Exception('Failed to exchange authorization code');
      }

      // Step 5: Extract session token and user data
      final sessionToken = callbackResponse['session_token'] as String?;
      final expiresAt = callbackResponse['expires_at'] as String?;
      final userEmail = callbackResponse['user']?['email'] as String?;

      if (sessionToken == null || sessionToken.isEmpty) {
        throw Exception('No session token received from backend');
      }

      // Step 6: Store session token securely
      final sessionService = ref.read(sessionServiceProvider);
      await sessionService.saveSession(
        token: sessionToken,
        expiresAt: DateTime.parse(expiresAt ?? DateTime.now().toString()),
        userEmail: userEmail,
      );

      // Step 7: Trigger login in auth controller (Riverpod state)
      await ref.read(authControllerProvider.notifier).login(sessionToken);

      // Step 8: Navigate to home screen
      if (mounted) {
        _navigateToHome();
      }
    } catch (e) {
      setState(() {
        _errorMessage = 'Sign-in failed: ${e.toString()}';
        _isLoading = false;
      });
      
      // Log error for debugging
      print('OAuth Error: $e');
    }
  }

  void _navigateToHome() {
    if (mounted) {
      Navigator.of(context).pushReplacementNamed('/home');
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Center(
        child: SingleChildScrollView(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              // Logo/Branding
              Icon(
                Icons.admin_panel_settings,
                size: 80,
                color: Colors.blue,
              ),
              const SizedBox(height: 24),
              const Text(
                'Personal AI Chief of Staff',
                style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
              ),
              const SizedBox(height: 48),

              // Sign-in button
              SizedBox(
                width: 300,
                height: 48,
                child: ElevatedButton(
                  onPressed: _isLoading ? null : _handleSignIn,
                  child: _isLoading
                      ? const SizedBox(
                          height: 24,
                          width: 24,
                          child: CircularProgressIndicator(strokeWidth: 2),
                        )
                      : const Text(
                          'Sign in with Google',
                          style: TextStyle(fontSize: 16),
                        ),
                ),
              ),

              // Error message
              if (_errorMessage != null) ...[
                const SizedBox(height: 24),
                Container(
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    color: Colors.red[100],
                    border: Border.all(color: Colors.red),
                    borderRadius: BorderRadius.circular(8),
                  ),
                  child: Text(
                    _errorMessage!,
                    style: TextStyle(color: Colors.red[900]),
                  ),
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }
}
```

