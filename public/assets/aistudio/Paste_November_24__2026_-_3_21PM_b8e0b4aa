### **2.4 Dependency Injection (Riverpod Provider)**
**File**: `app/lib/providers/auth_provider.dart`

Add to existing AuthController:

```dart
class AuthController extends AsyncNotifier<AuthState> {
  late final ApiClient _apiClient;

  @override
  Future<AuthState> build() async {
    _apiClient = ref.read(apiClientProvider);
    // Try to restore existing session on app startup
    final sessionService = ref.read(sessionServiceProvider);
    final restored = await sessionService.restoreSession();
    
    return AuthState(
      isAuthenticated: restored,
      sessionToken: restored ? await sessionService.getToken() : null,
      userEmail: null,
    );
  }

  Future<void> login(String sessionToken) async {
    state = const AsyncValue.loading();
    state = await AsyncValue.guard(() async {
      // Trigger token refresh to validate it works
      await _apiClient.post('/auth/refresh');
      
      return AuthState(
        isAuthenticated: true,
        sessionToken: sessionToken,
        userEmail: null,
      );
    });
  }

  Future<void> logout() async {
    state = const AsyncValue.loading();
    state = await AsyncValue.guard(() async {
      try {
        await _apiClient.post('/auth/logout');
      } catch (e) {
        print('Logout error: $e');
      }

      final sessionService = ref.read(sessionServiceProvider);
      await sessionService.clearSession();

      return AuthState(
        isAuthenticated: false,
        sessionToken: null,
        userEmail: null,
      );
    });
  }
}

// Add to AuthState
class AuthState {
  final bool isAuthenticated;
  final String? sessionToken;
  final String? userEmail;

  const AuthState({
    required this.isAuthenticated,
    required this.sessionToken,
    required this.userEmail,
  });
}
```

