# Google OAuth (from Google Cloud Console -> Google Auth Platform -> Clients)
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_WEB_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Comma-separated allowlist for OAuth redirects (add http://localhost:3000/auth.html for Flutter Web popup flow)
ALLOWED_OAUTH_REDIRECT_URIS=http://localhost:8000/auth/callback,http://localhost:3000/auth.html,http://localhost:8080/auth.html

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:7777,http://localhost:8080

# Database (SQLite for local dev; PostgreSQL on Render for production)
DATABASE_URL=sqlite:///./chief_of_staff.db

# Session security
SESSION_TOKEN_EXPIRY_DAYS=30
SESSION_BUFFER_MINUTES=5

# Symmetric token encryption key (generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=YOUR_FERNET_ENCRYPTION_KEY_HERE

# Gmail Polling Worker (Phase 2)
GMAIL_POLLING_ENABLED=true
GMAIL_POLL_INTERVAL_MINUTES=15
GMAIL_MAX_MESSAGES_PER_POLL=25
